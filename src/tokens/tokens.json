{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "description": "Design tokens extracted from Figma — BUSUP Design System",

  "color": {
    "primary": {
      "$description": "Main brand color — Green. Core of BUSUP's visual identity.",
      "100": {
        "$value": "#D7FFED",
        "$type": "color",
        "$description": "Primary green — lightest tint",
        "css": "var(--Primary-Primary_100, #D7FFED)"
      },
      "200": {
        "$value": "#B2FFDD",
        "$type": "color",
        "$description": "Primary green — light tint",
        "css": "var(--Primary-Primary_200, #B2FFDD)"
      },
      "300": {
        "$value": "#00BF6F",
        "$type": "color",
        "$description": "Primary green — base brand color (default)",
        "css": "var(--Primary-Primary_300, #00BF6F)"
      },
      "400": {
        "$value": "#049157",
        "$type": "color",
        "$description": "Primary green — dark shade",
        "css": "var(--Primary-Primary_400, #049157)"
      },
      "500": {
        "$value": "#0A5D3D",
        "$type": "color",
        "$description": "Primary green — darkest shade",
        "css": "var(--Primary-Primary_500, #0A5D3D)"
      }
    },

    "secondary": {
      "$description": "Secondary brand color — Orange.",
      "100": {
        "$value": "#FDE6E3",
        "$type": "color",
        "$description": "Secondary orange — lightest tint",
        "css": "var(--Secondary-Secondary_100, #FDE6E3)"
      },
      "200": {
        "$value": "#F9B3A8",
        "$type": "color",
        "$description": "Secondary orange — light tint",
        "css": "var(--Secondary-Secondary_200, #F9B3A8)"
      },
      "300": {
        "$value": "#EA6753",
        "$type": "color",
        "$description": "Secondary orange — base brand color (default)",
        "css": "var(--Secondary-Secondary_300, #EA6753)"
      },
      "400": {
        "$value": "#B33522",
        "$type": "color",
        "$description": "Secondary orange — dark shade",
        "css": "var(--Secondary-Secondary_400, #B33522)"
      },
      "500": {
        "$value": "#7C2C20",
        "$type": "color",
        "$description": "Secondary orange — darkest shade",
        "css": "var(--Secondary-Secondary_500, #7C2C20)"
      }
    },

    "neutral": {
      "$description": "Neutral grayscale palette — used for backgrounds, text, borders and surfaces.",
      "0": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$description": "Neutral — pure white",
        "css": "var(--Neutral-Neutral_0, #FFF)"
      },
      "50": {
        "$value": "#F4F4F4",
        "$type": "color",
        "$description": "Neutral — off-white / light background",
        "css": "var(--Neutral-Neutral_50, #F4F4F4)"
      },
      "100": {
        "$value": "#DBDBDB",
        "$type": "color",
        "$description": "Neutral — light border / disabled surface",
        "css": "var(--Neutral-Neutral_100, #DBDBDB)"
      },
      "200": {
        "$value": "#C4C4C4",
        "$type": "color",
        "$description": "Neutral — placeholder / subtle text",
        "css": "var(--Neutral-Neutral_200, #C4C4C4)"
      },
      "300": {
        "$value": "#989898",
        "$type": "color",
        "$description": "Neutral — secondary text / icons",
        "css": "var(--Neutral-Neutral_300, #989898)"
      },
      "400": {
        "$value": "#414141",
        "$type": "color",
        "$description": "Neutral — primary text (dark)",
        "css": "var(--Neutral-Neutral_400, #414141)"
      },
      "500": {
        "$value": "#212121",
        "$type": "color",
        "$description": "Neutral — near black / headings",
        "css": "var(--Neutral-Neutral_500, #212121)"
      },
      "1000": {
        "$value": "#000000",
        "$type": "color",
        "$description": "Neutral — pure black",
        "css": "var(--Neutral-Neutral_1000, #000)"
      }
    }
  },

  "spacing": {
    "xs": {
      "$value": "4px",
      "$type": "spacing",
      "$description": "Extra small — gap between icon and label, inner horizontal padding"
    },
    "sm": {
      "$value": "8px",
      "$type": "spacing",
      "$description": "Small — vertical padding (top/bottom) of the Button"
    },
    "2xl": {
      "$value": "24px",
      "$type": "spacing",
      "$description": "2X large — horizontal padding (left/right) of the Button"
    }
  },

  "component": {
    "button": {
      "$description": "Base layout and style tokens for the Button component",
      "layout": {
        "display": "inline-flex",
        "justifyContent": "center",
        "alignItems": "center",
        "paddingVertical": "{spacing.sm}",
        "paddingHorizontal": "{spacing.2xl}",
        "gap": "{spacing.xs}"
      },
      "color": {
        "background": "{color.primary.300}",
        "backgroundHover": "{color.primary.400}",
        "backgroundPressed": "{color.primary.500}"
      },
      "css": {
        "$value": "display: inline-flex; padding: var(--sm, 8px) var(--2xl, 24px); justify-content: center; align-items: center; gap: var(--xs, 4px);",
        "$type": "string",
        "$description": "Ready-to-use CSS shorthand for the Button component"
      }
    }
  }
}
